# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development   # Set to "production" on Render/Railway

# CORS — which frontend URL is allowed to call this API
# In development: http://localhost:5173 is always allowed automatically
# In production:  set this to your deployed Vercel URL
# Multiple URLs: comma-separated  →  https://myapp.vercel.app,https://staging.vercel.app
FRONTEND_URL=http://localhost:5173

# Google Gemini API key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default model (gemini-2.5-flash)
# Only change this if you get 404 errors — it means the model name changed.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: return a sample analysis instead of calling Gemini
# Useful when quota is exceeded or for offline demos
# MOCK_AI=true
